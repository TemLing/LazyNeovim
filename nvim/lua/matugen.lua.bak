 local M = {}

function M.setup()
  require('base16-colorscheme').setup({
    base00 = '#171215',
    base01 = '#241e21',
    base02 = '#2f282c',
    base03 = '#9d8c95',
    base04 = '#d4c1cb',
    base05 = '#ecdfe4',
    base06 = '#ecdfe4',
    base07 = '#ecdfe4',
    base08 = '#ffb4ab',
    base09 = '#ffb4ab',
    base0A = '#e4bbd4',
    base0B = '#ffade5',
    base0C = '#ffb4ab',
    base0D = '#ffade5',
    base0E = '#e4bbd4',
    base0F = '#ffd7ef',
  })

  local hi = function(group, opts)
    vim.api.nvim_set_hl(0, group, opts)
  end

  hi('TelescopeNormal',         { fg = '#ecdfe4',          bg = '#171215' })
  hi('TelescopeBorder',         { fg = '#9d8c95',             bg = '#171215' })
  hi('TelescopePromptNormal',   { fg = '#ecdfe4',          bg = '#171215' })
  hi('TelescopePromptBorder',   { fg = '#9d8c95',             bg = '#171215' })
  hi('TelescopePromptPrefix',   { fg = '#ffade5',             bg = '#171215' })
  hi('TelescopePromptCounter',  { fg = '#d4c1cb',  bg = '#171215' })
  hi('TelescopePromptTitle',    { fg = '#171215',             bg = '#ffade5' })
  hi('TelescopePreviewTitle',   { fg = '#171215',             bg = '#e4bbd4' })
  hi('TelescopeResultsTitle',   { fg = '#171215',             bg = '#ffb4ab' })
  hi('TelescopeSelection',      { fg = '#ecdfe4',          bg = '#2f282c' })
  hi('TelescopeSelectionCaret', { fg = '#ffade5',             bg = '#2f282c' })
  hi('TelescopeMatching',       { fg = '#ffade5',             bold = true })
end

-- Register a signal handler for SIGUSR1 (matugen updates).
-- The handler re-requires this module, which re-runs the code below, so the
-- previous handle is stopped first; otherwise handlers double on every signal.
if _G.__matugen_signal then
  _G.__matugen_signal:stop()
  _G.__matugen_signal:close()
end

local signal = vim.uv.new_signal()
_G.__matugen_signal = signal
signal:start(
  'sigusr1',
  vim.schedule_wrap(function()
    package.loaded['matugen'] = nil
    require('matugen').setup()
  end)
)

return M
